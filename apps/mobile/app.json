{
  "expo": {
    "name": "Devio Cliente",
    "slug": "devio-cliente",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "devio",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lat.devio.cliente"
    },
    "android": {
      "package": "lat.devio.cliente",
      "adaptiveIcon": {
        "backgroundColor": "#1F3652"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    }
  }
}
